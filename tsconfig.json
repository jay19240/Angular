{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "sourceMap": true,
    "declaration": false,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@app/*": [
        "./src/app/*"
      ],
      "@services/*": [
        "./src/app/services/*"
      ],
      "@shared/*": [
        "./src/app/shared/*"
      ],
      "@models": [
        "./src/models/index.ts"
      ]
    },
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
